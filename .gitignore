node_modules/
dist/
*.tsbuildinfo

# Generated by scripts/build-wasm.ps1
# build/ is intentionally committed: the parser artifact is what ships, and a
# clean clone must be able to pack and test without emsdk.
packages/*/.cache/
# Vendored curl-impersonate (installed by scripts/fetch-curl-impersonate.mjs)
packages/*/bin/

# Spike outputs
spikes/**/out-*.json
spikes/**/parity-report.json
spikes/**/css-golden.json
spikes/**/text-golden.json

# Python
spikes/**/.venv/
__pycache__/
*.pyc

# Third-party checkouts and downloaded artifacts that must not enter a public repo
spikes/**/scrapling-src/
spikes/**/libxml2-2.11.9/
spikes/**/*.tar.xz
spikes/libxml2-wasm/build/
spikes/curl-binary/extract/
spikes/curl-binary/tmp/
spikes/curl-binary/*.tar.gz
*.tgz
